{
  "enable_llm_tools": {
    "description": "注册为 LLM 工具",
    "type": "bool",
    "default": true,
    "hint": "开启后，下面的群管理功能会注册给大语言模型调用；关闭后只保留 /群管 指令。修改后需重载插件。"
  },
  "enable_auto_stt": {
    "description": "语音自动转文字",
    "type": "bool",
    "default": true,
    "hint": "开启后，用户发语音、或回复一条语音消息时，会在请求大模型前自动调用协议端 voice_msg_to_text，把转写文本注入上下文（还能在下面的分群开关里按群关闭）。"
  },
  "ban_fallback": {
    "description": "真禁言失败时的回退",
    "type": "string",
    "options": [
      "permission",
      "any",
      "off"
    ],
    "default": "permission",
    "hint": "机器人没有权限做真禁言时怎么处理。permission = 只在看起来是权限不足时回退成软禁言（默认）；any = 只要真禁言失败就回退；off = 不回退，直接报错。软禁言只阻断该用户触发大模型回复，不调用平台禁言接口。"
  },
  "max_ban_seconds": {
    "description": "模型禁言时长上限（秒）",
    "type": "int",
    "default": 300,
    "hint": "只约束模型调用禁言工具时的时长：时长由模型自主决定，超过这个上限会被截断。默认 300 秒（5 分钟）。管理员用 /群管 软禁言 手动设置不受此限制。"
  },
  "soft_mute_replies": {
    "description": "软禁言期间的回复",
    "type": "list",
    "default": [
      "（假装没听见）……",
      "哼，现在不想理你。",
      "（别过头去）等会儿再说吧。",
      "我现在不想说话，还剩 {remaining}。",
      "（捂住耳朵）不听不听。",
      "消停一会儿再来找我吧。"
    ],
    "hint": "软禁言期间随机挑一条回复给该用户。支持 {remaining} 占位符，会被替换成剩余时间。"
  },
  "unconfigured_group_policy": {
    "description": "未登记群聊的策略",
    "type": "string",
    "options": [
      "allow",
      "deny"
    ],
    "default": "allow",
    "hint": "allow：未在「分群功能开关」中登记的群默认启用全部功能；deny：默认全部禁用。"
  },
  "write_tool_permission": {
    "description": "写操作默认权限",
    "type": "string",
    "options": [
      "admin",
      "member"
    ],
    "default": "admin",
    "hint": "会改动内容的工具（禁言、改名、发公告、改文件、改机器人资料等）默认需要的权限。admin = 仅 AstrBot 管理员（主配置 admins_id 中的 QQ）；member = 所有群成员。"
  },
  "readonly_tool_permission": {
    "description": "只读查询默认权限",
    "type": "string",
    "options": [
      "admin",
      "member"
    ],
    "default": "admin",
    "hint": "只读查询类工具（获取群成员、群文件、群公告、群精华、相册列表等）默认需要的权限。默认 admin 表示「除下面豁免项外全部需要管理员」；想让普通成员也能查询就改成 member。"
  },
  "member_tools": {
    "description": "免管理员权限的工具",
    "type": "list",
    "default": [
      "onebot_set_group_card",
      "onebot_set_group_ban",
      "onebot_set_group_whole_ban",
      "onebot_get_group_shut_list"
    ],
    "hint": "列在这里的工具普通群成员也能用，不受上面两项默认权限影响。默认放开「设置别人群名片」与「禁言」相关工具。可填的工具名见插件 README 的功能表。"
  },
  "groups": {
    "type": "template_list",
    "description": "分群功能开关",
    "hint": "为每个群单独配置启用哪些功能。未登记的群按「未登记群聊的策略」处理。",
    "default": [],
    "templates": {
      "group": {
        "name": "群配置",
        "display_item": "group_id",
        "items": {
          "group_id": {
            "description": "群号",
            "type": "string",
            "default": ""
          },
          "enabled": {
            "description": "启用本插件",
            "type": "bool",
            "default": true,
            "hint": "关闭后该群所有功能都不可用。"
          },
          "card": {
            "description": "群名片与头衔",
            "type": "bool",
            "default": true,
            "hint": "设置群名片、设置群头衔。"
          },
          "mute": {
            "description": "禁言管理",
            "type": "bool",
            "default": true,
            "hint": "群禁言、群全体禁言、获取被禁言群员列表。"
          },
          "essence": {
            "description": "群精华消息",
            "type": "bool",
            "default": true,
            "hint": "获取/设置/删除群精华消息。"
          },
          "notice": {
            "description": "群公告",
            "type": "bool",
            "default": true,
            "hint": "发送/获取/删除群公告。"
          },
          "album": {
            "description": "群相册",
            "type": "bool",
            "default": true,
            "hint": "创建/删除相册、上传图片、获取相册列表与媒体列表。"
          },
          "portrait": {
            "description": "群头像",
            "type": "bool",
            "default": true,
            "hint": "设置群头像。"
          },
          "interact": {
            "description": "互动",
            "type": "bool",
            "default": true,
            "hint": "贴表情回应、发送戳一戳。"
          },
          "file": {
            "description": "群文件",
            "type": "bool",
            "default": true,
            "hint": "上传/删除/移动/重命名群文件与文件夹、转永久、查看文件系统信息与目录列表。"
          },
          "stt": {
            "description": "语音自动转文字",
            "type": "bool",
            "default": true,
            "hint": "用户发语音或回复语音时，自动调用协议端 voice_msg_to_text 把语音转成文字注入上下文。"
          },
          "self": {
            "description": "机器人自身",
            "type": "bool",
            "default": true,
            "hint": "修改机器人在当前群的名片（自己的群名片）、以及机器人自己的 QQ 头像。"
          }
        }
      }
    }
  }
}
