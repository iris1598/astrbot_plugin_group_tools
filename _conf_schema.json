{
  "enable_llm_tools": {
    "description": "注册为 LLM 工具",
    "type": "bool",
    "default": true,
    "hint": "开启后，下面的群管理功能会注册给大语言模型调用；关闭后只保留 /群管 指令。修改后需重载插件。"
  },
  "enable_auto_stt": {
    "description": "语音自动转文字",
    "type": "bool",
    "default": true,
    "hint": "开启后，用户发语音、或回复一条语音消息时，会在请求大模型前自动调用协议端 voice_msg_to_text，把转写文本注入上下文（还能在下面的分群开关里按群关闭）。"
  },
  "unconfigured_group_policy": {
    "description": "未登记群聊的策略",
    "type": "string",
    "options": [
      "allow",
      "deny"
    ],
    "default": "allow",
    "hint": "allow：未在「分群功能开关」中登记的群默认启用全部功能；deny：默认全部禁用。"
  },
  "require_admin_for_write": {
    "description": "写操作仅限管理员",
    "type": "bool",
    "default": true,
    "hint": "开启后，禁言、改名、删文件等写操作只允许 AstrBot 管理员（主配置 admins_id 中的 QQ）触发；只读查询不受限制。"
  },
  "groups": {
    "type": "template_list",
    "description": "分群功能开关",
    "hint": "为每个群单独配置启用哪些功能。未登记的群按「未登记群聊的策略」处理。",
    "default": [],
    "templates": {
      "group": {
        "name": "群配置",
        "display_item": "group_id",
        "items": {
          "group_id": {
            "description": "群号",
            "type": "string",
            "default": ""
          },
          "enabled": {
            "description": "启用本插件",
            "type": "bool",
            "default": true,
            "hint": "关闭后该群所有功能都不可用。"
          },
          "card": {
            "description": "群名片与头衔",
            "type": "bool",
            "default": true,
            "hint": "设置群名片、设置群头衔。"
          },
          "mute": {
            "description": "禁言管理",
            "type": "bool",
            "default": true,
            "hint": "群禁言、群全体禁言、获取被禁言群员列表。"
          },
          "essence": {
            "description": "群精华消息",
            "type": "bool",
            "default": true,
            "hint": "获取/设置/删除群精华消息。"
          },
          "notice": {
            "description": "群公告",
            "type": "bool",
            "default": true,
            "hint": "发送/获取/删除群公告。"
          },
          "album": {
            "description": "群相册",
            "type": "bool",
            "default": true,
            "hint": "创建/删除相册、上传图片、获取相册列表与媒体列表。"
          },
          "portrait": {
            "description": "群头像",
            "type": "bool",
            "default": true,
            "hint": "设置群头像。"
          },
          "interact": {
            "description": "互动",
            "type": "bool",
            "default": true,
            "hint": "贴表情回应、发送戳一戳。"
          },
          "file": {
            "description": "群文件",
            "type": "bool",
            "default": true,
            "hint": "上传/删除/移动/重命名群文件与文件夹、转永久、查看文件系统信息与目录列表。"
          },
          "stt": {
            "description": "语音自动转文字",
            "type": "bool",
            "default": true,
            "hint": "用户发语音或回复语音时，自动调用协议端 voice_msg_to_text 把语音转成文字注入上下文。"
          }
        }
      }
    }
  }
}
